# syntax=docker/dockerfile:1
# Packages the Linux binaries built by the publish workflow without recompiling them.
FROM --platform=$BUILDPLATFORM alpine:3 AS certificates
RUN apk add --no-cache ca-certificates

FROM alpine:3
ARG TARGETARCH
RUN mkdir /cache && chown 10001:10001 /cache
COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chmod=0755 release-bin/mori-linux-${TARGETARCH} /usr/local/bin/mori
USER 10001:10001
ENV CACHE_DIR=/cache
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/usr/local/bin/mori", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/mori"]
