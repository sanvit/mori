# ── Unified server ────────────────────────────────────────
# browser: file browser at /; spa: website with SPA fallback; direct: file site.
# Files are available at /path/to/file without S3 keys in every mode.
# Internal routes are reserved under /_mori/.
SERVE_MODE=browser
# internal (default): embedded cache for every backend; off: no body cache.
CACHE_MODE=internal
# Internal caching applies to browser, spa and direct alike. Browser file
# responses stay private,no-store for clients; this does not disable disk HITs.
# Presigned GETs bypass mori and its internal cache.
# Storage settings for the selected backend are required. Missing settings stop
# startup; no sample fallback.

# s3 (default), webdav, ftp, or sftp. Only the matching section below is read.
# presigned delivery requires s3; other backends always
# stream through mori (proxy mode).
STORAGE_BACKEND=s3
# Folder to publish as the browser root, e.g. team/reports. Works for every
# backend and is applied inside S3_PREFIX / WEBDAV_URL / FTP_PATH / SFTP_PATH.
# Visitors cannot see or reach anything above it, and it is never sent to the UI.
STORAGE_BASE_PATH=

BROWSER_TITLE='Files'
BROWSER_LISTEN_ADDR=:8080
BROWSER_PORT=8080
# Startup fails closed unless auth is configured or PUBLIC=true.
BROWSER_USERNAME=
BROWSER_PASSWORD=
# These are mori HTTP Basic credentials in ALL serve modes, not storage keys.
BROWSER_PUBLIC=false
# Optional AUTH_MODE=basic/public overrides the legacy public/auth selection.
# AUTH_MODE=public clears browser credentials and explicitly publishes files.
BROWSER_LIST_TTL=30s
# Individual object delivery: proxy or presigned, independently selectable.
# proxy = storage -> mori's embedded cache -> client (off skips the cache).
# presigned = GET Object only, redirected to S3; no object body through mori.
# HEAD and ListObjectsV2 stay server-side; neither gets a presigned URL.
BROWSER_DOWNLOAD_MODE=proxy
# In-app PDF/text in presigned mode require bucket CORS. See docs/PREVIEW.md.
BROWSER_PREVIEW_MODE=proxy
# Render .html/.htm in preview and new tabs (default: source text).
# Isolated HTML: inline CSS/data images allowed. Optional scripts/external assets below.
# HTML rendering always uses proxy delivery so the sandbox policy is enforced.
BROWSER_HTML_PREVIEW_ENABLED=false
# Only effective when HTML rendering is enabled. Apply to previews AND new tabs.
BROWSER_HTML_PREVIEW_SCRIPTS=false
# Allow HTTP(S) images, styles, fonts, media and fetch; external scripts also need SCRIPTS=true.
BROWSER_HTML_PREVIEW_EXTERNAL_RESOURCES=false
BROWSER_PRESIGN_TTL=15m
# Optional public S3 API endpoint when S3_ENDPOINT is internal (e.g. MinIO).
# The final hostname is signed. Same bucket/region/path-style; not a website URL.
BROWSER_PRESIGN_ENDPOINT=

# Multi-file ZIP download. false removes the selection checkboxes from the UI and
# makes /_mori/api/archive return 404. Single-file downloads and previews still work.
BROWSER_ZIP_ENABLED=true
# ZIP always streams through the server, using Store (no compression).
# Selected folders include all descendants and pages; UI listing stays one-level.
# Actual recursive file count (1-10000), not number of selected folder checkboxes.
# Folder marker count has the same separate limit. Exceeding limits rejects the ZIP.
BROWSER_ZIP_MAX_FILES=200
BROWSER_ZIP_MAX_SIZE=20GiB
BROWSER_ZIP_CONCURRENCY=2

# ── WebDAV (STORAGE_BACKEND=webdav) ──────────────────────────
# Collection URL to publish. Basic auth only; use HTTPS outside a private network.
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# ── FTP / FTPS (STORAGE_BACKEND=ftp) ─────────────────────────
# host or host:port (default port 21). FTP_TLS=true uses explicit FTPS (AUTH TLS).
FTP_ADDR=
FTP_USERNAME=anonymous
FTP_PASSWORD=
FTP_TLS=false
# Remote directory to publish: absolute (/pub) or relative to the login home.
FTP_PATH=/

# ── SFTP (STORAGE_BACKEND=sftp) ──────────────────────────────
# host or host:port (default port 22). Password and/or private key.
SFTP_ADDR=
SFTP_USERNAME=
SFTP_PASSWORD=
# Authentication: choose inline SFTP_KEY OR SFTP_KEY_FILE, not both.
# SFTP_KEY accepts OpenSSH/PEM text with actual newlines or literal \n.
# Single-line .env sample (replace BASE64_PRIVATE_KEY_BODY with your key body):
# SFTP_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\nBASE64_PRIVATE_KEY_BODY\n-----END OPENSSH PRIVATE KEY-----"
SFTP_KEY=
# Optional passphrase for an encrypted inline key or key file; NOT SFTP_PASSWORD.
SFTP_KEY_PASSPHRASE=
# File alternative, e.g. /run/secrets/id_ed25519 (leave empty with SFTP_KEY).
SFTP_KEY_FILE=
# Server verification: choose inline SFTP_HOST_KEY OR SFTP_KNOWN_HOSTS, not both.
# Inline format is ONE OpenSSH PUBLIC key, not a private key or SHA256 fingerprint.
# Sample (replace BASE64_SERVER_PUBLIC_KEY; optional trailing comment):
# SFTP_HOST_KEY='ssh-ed25519 BASE64_SERVER_PUBLIC_KEY sftp.example.com'
# Obtain the server's host .pub key via a trusted admin/channel. ssh-keyscan
# output alone is NOT trusted; verify its fingerprint independently first.
SFTP_HOST_KEY=
# File alternative: path to known_hosts, e.g. /run/secrets/known_hosts.
SFTP_KNOWN_HOSTS=
# Explicitly skips verification; cannot be combined with either host key setting.
# Not recommended. Prefer a verified SFTP_HOST_KEY or SFTP_KNOWN_HOSTS.
SFTP_INSECURE_HOST_KEY=false
# Remote directory to publish: absolute or relative to the login home (.).
SFTP_PATH=.

# ── S3 (STORAGE_BACKEND=s3) ────────────────────────────────
S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
S3_REGION=ap-northeast-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true
# Publish only this prefix. Example: public/downloads/
S3_PREFIX=

# ── Object cache (S3 / WebDAV / FTP / FTPS / SFTP) ─────────
CACHE_ENABLED=true
CACHE_DIR=./cache
CACHE_MAX_DISK_SIZE=100GiB
# 0 means unlimited. The limit counts segment bytes, not metadata/temp overhead.
CACHE_BLOCK_SIZE=8MiB
CACHE_SEGMENT_SIZE=2MiB
CACHE_DOWNLOAD_CONCURRENCY=4
ORIGIN_FETCH_MAX_SIZE=16MiB
ORIGIN_MAX_CONCURRENT_REQUESTS=32
CACHE_QUERY_MODE=sort
CACHE_RESPECT_ORIGIN=true
CACHE_DEFAULT_TTL=1h
CACHE_MIN_TTL=0s
CACHE_MAX_TTL=168h
CACHE_STALE_IF_ERROR=24h
CACHE_NEGATIVE_TTL_404=30s
CACHE_NEGATIVE_TTL_403=10s
# First matching rule wins. ttl bypasses origin policy; browser_ttl controls
# site response max-age only (browser/API responses remain private,no-store).
CACHE_RULES_JSON=[]
# Example: [{"prefix":"/assets/","ttl":"24h","browser_ttl":"1h","ignore_query":true}]

# ── Website routing ─────────────────────────────────────
# Unset INDEX_DOCUMENT defaults to empty in browser, index.html in spa/direct.
# Explicitly empty disables directory index resolution.
# INDEX_DOCUMENT=index.html
SPA_INDEX=/index.html
SPA_ALLOW_DOTTED_ROUTES=false
# SPA_MODE is a legacy alias; use SERVE_MODE instead.
ERROR_PAGE_404=
ERROR_PAGES_JSON={}

# ── Operations ──────────────────────────────────────────
HEALTH_PATH=/_mori/healthz
ACCESS_LOG=true
SHUTDOWN_TIMEOUT=30s
