# ── mori / Browser ─────────────────────────────────────────
# Storage settings for the selected backend are required. Missing settings stop
# startup; no sample fallback.

# s3 (default), webdav, ftp, or sftp. Only the matching section below is read.
# presigned delivery and BROWSER_PROXY_URL require s3; other backends always
# stream through mori (proxy mode).
STORAGE_BACKEND=s3
# Folder to publish as the browser root, e.g. team/reports. Works for every
# backend and is applied inside S3_PREFIX / WEBDAV_URL / FTP_PATH / SFTP_PATH.
# Visitors cannot see or reach anything above it, and it is never sent to the UI.
STORAGE_BASE_PATH=

BROWSER_TITLE='Files'
BROWSER_LISTEN_ADDR=:8080
BROWSER_PORT=8080
# Startup fails closed unless auth is configured or PUBLIC=true.
BROWSER_USERNAME=
BROWSER_PASSWORD=
BROWSER_PUBLIC=false
BROWSER_LIST_TTL=30s
# Empty = mori streams from S3 itself, without object disk caching.
# Optional: URL of an independently managed S3 object proxy.
# Configure its storage and cache settings in that proxy's environment.
# Disable its index, SPA and custom error fallbacks for exact object delivery.
BROWSER_PROXY_URL=

# Individual object delivery: proxy or presigned, independently selectable.
# proxy = S3 -> optional s3-proxy cache -> mori -> browser.
# presigned = GET Object only, redirected to S3; no object body through mori.
# HEAD and ListObjectsV2 stay server-side; neither gets a presigned URL.
BROWSER_DOWNLOAD_MODE=proxy
# In-app PDF/text in presigned mode require bucket CORS. See docs/PREVIEW.md.
BROWSER_PREVIEW_MODE=proxy
# Render .html/.htm in preview and new tabs (default: source text).
# Isolated HTML: inline CSS/data images allowed. Optional scripts/external assets below.
# HTML rendering always uses proxy delivery so the sandbox policy is enforced.
BROWSER_HTML_PREVIEW_ENABLED=false
# Only effective when HTML rendering is enabled. Apply to previews AND new tabs.
BROWSER_HTML_PREVIEW_SCRIPTS=false
# Allow HTTP(S) images, styles, fonts, media and fetch; external scripts also need SCRIPTS=true.
BROWSER_HTML_PREVIEW_EXTERNAL_RESOURCES=false
BROWSER_PRESIGN_TTL=15m
# Optional public S3 API endpoint when S3_ENDPOINT is internal (e.g. MinIO).
# The final hostname is signed. Same bucket/region/path-style; not a website URL.
BROWSER_PRESIGN_ENDPOINT=

# Multi-file ZIP download. false removes the selection checkboxes from the UI and
# makes /api/archive return 404. Single-file downloads and previews still work.
BROWSER_ZIP_ENABLED=true
# ZIP always streams through the server, using Store (no compression).
# Selected folders include all descendants and pages; UI listing stays one-level.
# Actual recursive file count (1-10000), not number of selected folder checkboxes.
# Folder marker count has the same separate limit. Exceeding limits rejects the ZIP.
BROWSER_ZIP_MAX_FILES=200
BROWSER_ZIP_MAX_SIZE=20GiB
BROWSER_ZIP_CONCURRENCY=2

# ── WebDAV (STORAGE_BACKEND=webdav) ──────────────────────────
# Collection URL to publish. Basic auth only; use HTTPS outside a private network.
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# ── FTP / FTPS (STORAGE_BACKEND=ftp) ─────────────────────────
# host or host:port (default port 21). FTP_TLS=true uses explicit FTPS (AUTH TLS).
FTP_ADDR=
FTP_USERNAME=anonymous
FTP_PASSWORD=
FTP_TLS=false
# Remote directory to publish: absolute (/pub) or relative to the login home.
FTP_PATH=/

# ── SFTP (STORAGE_BACKEND=sftp) ──────────────────────────────
# host or host:port (default port 22). Password and/or private key file.
SFTP_ADDR=
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_KEY_FILE=
# Host key verification is required: point at a known_hosts file, e.g. from
#   ssh-keyscan -t ed25519 host > known_hosts
# SFTP_INSECURE_HOST_KEY=true skips verification (not for untrusted networks).
SFTP_KNOWN_HOSTS=
SFTP_INSECURE_HOST_KEY=false
# Remote directory to publish: absolute or relative to the login home (.).
SFTP_PATH=.

# ── S3 (STORAGE_BACKEND=s3) ────────────────────────────────
S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
S3_REGION=ap-northeast-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true
# Publish only this prefix. Example: public/downloads/
S3_PREFIX=

# ── Operations ───────────────────────────────────────────
# If BROWSER_PROXY_URL is set, match that proxy's health path here.
# An object with that name is read directly from S3 to avoid a route collision.
# This does not change mori's own /healthz endpoint.
HEALTH_PATH=/healthz
SHUTDOWN_TIMEOUT=30s
